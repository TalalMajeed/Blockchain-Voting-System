FROM node:20-alpine

WORKDIR /app

# Copy package files first to leverage build caching
COPY package*.json ./

# Copy Prisma schema early so postinstall works
COPY prisma ./prisma
COPY .env ./

# Install dependencies
RUN npm ci

RUN npx prisma generate
RUN npx prisma db push

# Now copy the rest of your source code
COPY . .

# Build NestJS
RUN npm run build

# Copy Swagger doc into dist
COPY swagger.yaml ./dist/

EXPOSE 5500

CMD ["npm", "run", "start:prod"]
